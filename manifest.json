{
  "manifest_version": 3,
  "name": "AI 答题助手",
  "version": "1.1.1",
  "description": "一键识别当前页面题目，调用 AI 给出答案与解析。支持 DeepSeek / OpenAI / 通义 / Kimi 等任意 OpenAI 兼容接口。",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI 答题助手",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/extract.js", "content/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "打开 / 关闭 AI 答题面板"
    }
  }
}